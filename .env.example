# ShopSifu Server Environment Variables
# Copy this file to .env and update with your values
# cp .env.example .env

NODE_ENV=production
APP_NAME=shopsifu
APP_DEBUG=false
APP_LOG_LEVEL=info
APP_CORS_ORIGINS=https://shopsifu.live,https://www.shopsifu.live,https://api.shopsifu.live,http://localhost:8000,https://localhost:8000

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1

# Node.js Performance
NODE_OPTIONS=--max-old-space-size=16384
UV_THREADPOOL_SIZE=64

# Authentication
AUTH_ACCESS_TOKEN_SECRET="CHANGE_THIS_SECRET_KEY_IN_PRODUCTION"
AUTH_ACCESS_TOKEN_EXP=1d
AUTH_REFRESH_TOKEN_SECRET="CHANGE_THIS_SECRET_KEY_IN_PRODUCTION"
AUTH_REFRESH_TOKEN_EXP=7d
AUTH_OTP_EXP=5m

# Cookie
COOKIE_SECURE=true

# Access Token Cookie
COOKIE_ACCESS_TOKEN_PATH="/"
COOKIE_ACCESS_TOKEN_DOMAIN=""

# Refresh Token Cookie
COOKIE_REFRESH_TOKEN_PATH="/"
COOKIE_REFRESH_TOKEN_DOMAIN=""

# CSRF Token Cookie
COOKIE_CSRF_TOKEN_PATH="/"
COOKIE_CSRF_TOKEN_DOMAIN=""
COOKIE_CSRF_TOKEN_EXP=1h

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_REDIRECT_URI=https://shopsifu.live/oauth-google-callback
GOOGLE_REDIRECT_URI_GOOGLE_CALLBACK=https://api.shopsifu.live/auth/google/callback

# Admin User
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD="CHANGE_THIS_PASSWORD_IN_PRODUCTION"
ADMIN_EMAIL="admin@shopsifu.live"
ADMIN_PHONE_NUMBER=0123456789

# Database
# When using Docker, connect to localhost:5432 (port is exposed from container)
# Database credentials should match docker-compose.core.yml
DATABASE_URL=postgresql://shopsifu:Shopsifu2025@localhost:5432/shopsifu?schema=public&connection_limit=5

# Redis
# When using Docker, connect to localhost:6379 (port is exposed from container)
# Password should match docker-compose.core.yml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Shopsifu2025
REDIS_URL=redis://:Shopsifu2025@localhost:6379
REDIS_REQUIRE_AUTH=true

# Elasticsearch
# When using Docker, connect to localhost:9200 (port is exposed from container)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX_PRODUCTS=products
ELASTICSEARCH_CLUSTER_NAME=shopsifu-cluster

# Grafana (for monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Payment Gateway
PAYMENT_API_KEY="CHANGE_THIS_IN_PRODUCTION"

# VNPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECURE_SECRET=your_vnpay_secure_secret

# AWS S3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=shopsifu

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# GiaoHangNhanh (GHN)
GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_HOST=https://online-gateway.ghn.vn
GHN_TEST_MODE=false
GHN_TRACKING_HOST=https://tracking.ghn.vn/

# ===========================================
# DOCKER NOTES:
# ===========================================
#
# If using Docker for services (recommended):
# - PostgreSQL, Redis, Elasticsearch run in containers
# - Ports are exposed to host (localhost)
# - Use localhost in connection strings above
#
# Default Docker credentials:
# - PostgreSQL: shopsifu / Shopsifu2025
# - Redis: password = Shopsifu2025
# - Elasticsearch: no authentication (single-node mode)
#
# To change passwords, update:
# 1. docker-compose.core.yml
# 2. This .env file
#
# ===========================================
# SECURITY NOTES:
# ===========================================
#
# ⚠️  IMPORTANT: Change all default passwords and secrets before production!
#
# 1. Change AUTH_ACCESS_TOKEN_SECRET and AUTH_REFRESH_TOKEN_SECRET
# 2. Change ADMIN_PASSWORD
# 3. Change database passwords in docker-compose.core.yml
# 4. Change Redis password in docker-compose.core.yml
# 5. Update API keys and secrets for third-party services
#
# Use strong, random passwords. You can generate them with:
#   openssl rand -base64 32

